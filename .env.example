# Copy to .env (ignored by git) and fill in. Used by the importer's AI step.

# Option A: Anthropic (schema enforced by the API).
# OSEMKA_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OSEMKA_ANTHROPIC_BASE_URL=   (optional; ANTHROPIC_BASE_URL inherited from the terminal is ignored)

# Option B: Qwen Cloud or any OpenAI-compatible endpoint (JSON mode, checked by the importer).
# Note: Qwen Token Plan keys (sk-sp-) are licensed for interactive coding tools only;
# Qwen's pay-as-you-go keys (sk-, sk-ws-) are the ones intended for scripts.
OSEMKA_AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus
