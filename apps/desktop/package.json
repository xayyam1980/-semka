{
  "name": "@osemka/desktop",
  "productName": "Ósemka",
  "version": "0.1.0",
  "private": true,
  "description": "Ósemka: przygotowanie do egzaminu ósmoklasisty",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "node scripts/ensure-electron.mjs && electron-vite build && node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "rebuild:native": "electron-builder install-app-deps",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "icon": "electron scripts/make-icon.cjs",
    "smoke:packaged": "node scripts/smoke.mjs",
    "dist:win:mac": "electron-vite build && electron-builder --win -c.toolsets.nsis=1.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@osemka/ai": "workspace:*",
    "@osemka/schema": "workspace:*",
    "@osemka/scoring": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "author": "Ósemka"
}
